filters:
  and:
    - file.path.startsWith("bōchord")
    - file.ext == "md"
    - '!file.tags.contains("Index")'
properties:
  note.stars:
    displayName: Rating
views:
  - type: list
    name: Index
    groupBy:
      property: categories
      direction: ASC
    order:
      - file.name
      - tags
    markers: none
  - type: table
    name: Zahra
    filters:
      and:
        - file.tags.contains("zahra")
    groupBy:
      property: categories
      direction: ASC
    order:
      - file.name
      - stars
      - page
      - Date
    sort:
      - property: rating
        direction: DESC
    indentProperties: false
    separator: "-"
  - type: list
    name: Reviews
    filters:
      and:
        - "!stars.isEmpty()"
    groupBy:
      property: categories
      direction: ASC
    order:
      - file.name
      - stars
    sort:
      - property: rating
        direction: DESC
      - property: title
        direction: ASC
    indentProperties: false
    separator: " • "
  - type: calendar
    name: Cal
    startDate: note.Date
  - type: table
    name: Zahra Index
    filters:
      and:
        - file.tags.contains("zahra")
    groupBy:
      property: categories
      direction: ASC
    order:
      - file.name
      - stars
      - page
      - Date
    sort:
      - property: rating
        direction: DESC
    indentProperties: false
    separator: "-"
  - type: cards
    name: Books
    filters:
      and:
        - categories.contains("Books")
    order:
      - file.name
      - stars
      - Author
    sort:
      - property: rating
        direction: DESC
      - property: file.name
        direction: ASC
    image: note.cover
    imageAspectRatio: 1.5
    cardSize: 190
  - type: cards
    name: Movies
    filters:
      and:
        - categories.contains("Movies")
    order:
      - file.name
      - stars
    sort:
      - property: Date
        direction: DESC
    image: note.cover
    imageAspectRatio: 1.5
    cardSize: 190
